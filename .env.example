# DataLeakDetector runtime configuration.
# Copy to .env for local secrets. Do not commit real API keys.

# Optional Neo4j-backed log miner. Leave unset for the default in-memory log miner.
# DLD_NEO4J_LOG_MINER=1
# DLD_NEO4J_URI=bolt://localhost:7687
# DLD_NEO4J_USER=neo4j
# DLD_NEO4J_PASSWORD=data-leak-detector
# DLD_NEO4J_DATABASE=neo4j

# Policy and groundtruth label configuration.
DLD_POLICY_CONFIG=spec/config/policy.json
DLD_SENSITIVE_TOKENS=
DLD_TRANSFER_TOKENS=
DLD_SINK_TOKENS=
DLD_SENSITIVE_SOURCE_FIELDS=sensitive_file_path,sensitive_file,sensitive_path,source_file
DLD_SENSITIVE_SOURCE_JSON_PATHS=
DLD_SENSITIVE_SOURCE_REGEXES=
DLD_SENSITIVE_SOURCE_ALLOW_EMPTY=0
DLD_GROUNDTRUTH_POLICY_CONFIG=spec/config/groundtruth_policy.json
DLD_GROUNDTRUTH_LEAK_TOKENS=
DLD_GROUNDTRUTH_NON_LEAK_TOKENS=
DLD_GROUNDTRUTH_UNKNOWN_RISK_TOKENS=

# Direct-keyframe visual analysis. No OCR, ROI, triage, or alternate vision mode.
DLD_VISION_ENABLED=0
DLD_FRAME_WINDOW_BEFORE_MS=30000
DLD_FRAME_WINDOW_AFTER_MS=120000
DLD_CASE_SEGMENT_MS=300000
DLD_FRAME_STEP_MS=1000
DLD_STRONG_FRAME_STEP_MS=250
DLD_WEAK_FRAME_STEP_MS=2000
DLD_STRONG_WINDOW_BEFORE_MS=5000
DLD_STRONG_WINDOW_AFTER_MS=15000
DLD_FRAME_DIFF_THRESHOLD=0.08
DLD_STRONG_FRAME_DIFF_THRESHOLD=0.015
DLD_FRAME_EXACT_DUPLICATE_THRESHOLD=0.001
DLD_FRAME_NEAR_DUPLICATE_THRESHOLD=0.01
DLD_FRAME_HASH_DISTANCE_THRESHOLD=12
DLD_FRAME_MIN_KEEP_GAP_MS=0
DLD_FRAME_PROBE_MULTIPLIER=6
DLD_FRAME_SEQUENTIAL_GAP_MS=5000
DLD_FRAME_ANCHOR_DUPLICATE_GAP_MS=500
DLD_MAX_KEYFRAMES_PER_WINDOW=18
DLD_MAX_KEYFRAMES_PER_STRONG_WINDOW=8
DLD_MAX_KEYFRAMES_PER_MEDIUM_WINDOW=2
DLD_MAX_KEYFRAMES_PER_WEAK_WINDOW=2
DLD_INCLUDE_WEAK_WINDOWS=0
DLD_INCLUDE_UNANCHORED_MEDIUM_WINDOWS=0
DLD_MAX_VLM_FRAMES=-1

# VLM Coding Plan endpoint. Put the real key in local .env only.
DLD_VLM_MODEL=qwen3.7-plus
DLD_VLM_TIMEOUT_SECONDS=300
DLD_VLM_CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DLD_VLM_CODING_API_KEY=
DLD_VLM_USE_CODING_PLAN=1
DLD_VLM_FAST_DISPATCH=1
DLD_VLM_WORKERS=4
DLD_VLM_DRY_RUN=0
DLD_VLM_GRID_SIZE=1
DLD_VLM_MAX_IMAGE_SIDE=1280
