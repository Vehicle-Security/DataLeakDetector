# DataLeakDetector 运行时配置

# Neo4j 是可选能力。不开启时，流水线不会连接图数据库。
DLD_NEO4J_ENABLED=0
DLD_NEO4J_URI=bolt://localhost:7687
DLD_NEO4J_USER=neo4j
DLD_NEO4J_PASSWORD=data-leak-detector
DLD_NEO4J_DATABASE=neo4j

# 设为 1 时，Neo4j 写入失败会让流水线失败。
# 设为 0 时，图谱写入错误只记录到 report["graph"]。
DLD_NEO4J_STRICT=0

# 设为 1 时，每次写入前会清理同一 report id 下的旧节点。
DLD_NEO4J_CLEAR_SESSION=0

# 设为 1 时，Neo4j 会前置参与日志挖掘：导入/复用 case 日志图，再用 Cypher 生成抽帧时间窗。
# 不开启时仍使用内存 LogMiner，速度最快，也不依赖数据库。
DLD_NEO4J_LOG_MINER=0
# 固定数据集反复调试时建议保持为 1：同一 case 的日志 hash 未变化就跳过重复入库。
DLD_NEO4J_REUSE_IMPORT=1
# 设为 1 时，Neo4j 前置挖掘失败会让流水线失败；默认失败后回退到内存 LogMiner。
DLD_NEO4J_LOG_MINER_STRICT=0
DLD_NEO4J_LOG_MINER_SCHEMA_VERSION=1
# Neo4j 前置日志入库批大小。24h 长日志建议保持分批，避免单事务过大。
DLD_NEO4J_LOG_MINER_BATCH_SIZE=2000

# 策略主配置。换数据集时优先改这个 JSON；临时追加词再用下面三个变量。
DLD_POLICY_CONFIG=spec/config/policy.json

# 数据集相关策略词临时扩展。用英文逗号分隔，默认留空。
DLD_SENSITIVE_TOKENS=
DLD_TRANSFER_TOKENS=
DLD_SINK_TOKENS=

# 从数据集标注文件提取初始敏感源文件。
# 这里应只指向 groundtruth 中的源文件字段，衍生文件由血缘/推理得出。
DLD_SENSITIVE_SOURCE_FIELDS=sensitive_file_path,sensitive_file,sensitive_path,source_file
DLD_SENSITIVE_SOURCE_JSON_PATHS=
# 留空会使用内置的 sensitive_file_path 兜底正则。
DLD_SENSITIVE_SOURCE_REGEXES=
DLD_SENSITIVE_SOURCE_ALLOW_EMPTY=0

# groundtruth 结论口径。当前最终 conclusion 在有 groundtruth 时以这里为准。
DLD_GROUNDTRUTH_POLICY_CONFIG=spec/config/groundtruth_policy.json
DLD_GROUNDTRUTH_LEAK_TOKENS=
DLD_GROUNDTRUTH_NON_LEAK_TOKENS=
DLD_GROUNDTRUTH_UNKNOWN_RISK_TOKENS=

# OCR/VLM 视觉分析默认关闭，避免不必要的模型调用成本。
DLD_VISION_ENABLED=0
DLD_VISION_MODE=hybrid
DLD_FRAME_WINDOW_BEFORE_MS=30000
DLD_FRAME_WINDOW_AFTER_MS=120000
DLD_FRAME_STEP_MS=1000
DLD_STRONG_FRAME_STEP_MS=250
DLD_WEAK_FRAME_STEP_MS=2000
DLD_STRONG_WINDOW_BEFORE_MS=5000
DLD_STRONG_WINDOW_AFTER_MS=15000
DLD_FRAME_DIFF_THRESHOLD=0.08
# strong 窗口通常是小弹窗/文件选择器，整帧差异会被桌面背景稀释，所以阈值更低。
DLD_STRONG_FRAME_DIFF_THRESHOLD=0.015
# 抽到后仍会去掉几乎完全一致的重复帧；锚点帧也要过这个过滤。
DLD_FRAME_EXACT_DUPLICATE_THRESHOLD=0.001
# 16x16 感知哈希距离小于等于该值时认为是近重复帧；默认只去掉非常相似的画面。
DLD_FRAME_HASH_DISTANCE_THRESHOLD=12
# 默认不按时间强制限流，避免错过快速出现的上传/选择/弹窗状态。
DLD_FRAME_MIN_KEEP_GAP_MS=0
DLD_MAX_KEYFRAMES_PER_WINDOW=18
DLD_MAX_KEYFRAMES_PER_STRONG_WINDOW=24
DLD_MAX_VLM_FRAMES=8

# OCR 提供方。推荐 rapidocr；可选 none / rapidocr / tesseract。
DLD_OCR_PROVIDER=rapidocr
DLD_OCR_MIN_CONFIDENCE=0.70
DLD_OCR_TEXT_SIMILARITY_THRESHOLD=0.92
# OCR 前先把长边压到该尺寸；0 表示不缩放。默认适合 2K/3K 屏幕录制。
DLD_OCR_MAX_IMAGE_SIDE=1280
# OCR 并行度。GPU 可先试 2；更高并不一定更快，可能被显存和后处理拖慢。
DLD_OCR_WORKERS=1
# OCR 前用 OpenCV 裁剪少量疑似文字区域，减少整帧 OCR 成本。
DLD_OCR_ROI_ENABLED=0
# 优先裁剪最像前台窗口的大区域；找不到窗口时再退回文字区域检测。
DLD_OCR_ROI_WINDOW_FIRST=1
DLD_OCR_ROI_MIN_TEXT_DENSITY=0.002
DLD_OCR_ROI_MAX_REGIONS=3
DLD_OCR_ROI_PADDING=24
# 安装 onnxruntime-gpu 且 CUDAExecutionProvider 能实际创建会话时设为 1。
DLD_RAPIDOCR_USE_CUDA=0

# OpenAI 兼容的 VLM 接口。真实密钥只放本地 .env。
DLD_VLM_PROVIDER=openai_compatible
DLD_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DLD_VLM_CHAT_URL=
DLD_VLM_MODEL=qwen-vl-max-latest
DLD_VLM_API_KEY=
DLD_VLM_TIMEOUT_SECONDS=60
