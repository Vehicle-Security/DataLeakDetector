# DataLeakDetector runtime configuration

# Neo4j is optional. The pipeline runs without it unless this flag is enabled.
DLD_NEO4J_ENABLED=0
DLD_NEO4J_URI=bolt://localhost:7687
DLD_NEO4J_USER=neo4j
DLD_NEO4J_PASSWORD=data-leak-detector
DLD_NEO4J_DATABASE=neo4j

# If set to 1, pipeline execution fails when Neo4j write fails.
# If set to 0, graph write errors are recorded in report["graph"].
DLD_NEO4J_STRICT=0

# If set to 1, each write removes previous nodes for the same report id first.
DLD_NEO4J_CLEAR_SESSION=0

# Dataset-specific policy extensions. Comma-separated; leave empty by default.
DLD_SENSITIVE_TOKENS=
DLD_TRANSFER_TOKENS=
DLD_SINK_TOKENS=

# OCR/VLM frame analysis is optional and disabled by default to avoid cost.
DLD_VISION_ENABLED=0
DLD_VISION_MODE=hybrid
DLD_FRAME_WINDOW_BEFORE_MS=30000
DLD_FRAME_WINDOW_AFTER_MS=120000
DLD_FRAME_STEP_MS=1000
DLD_FRAME_DIFF_THRESHOLD=0.08
DLD_MAX_KEYFRAMES_PER_WINDOW=18
DLD_MAX_VLM_FRAMES=8

# OCR provider. Use "tesseract" only when local Tesseract is installed.
DLD_OCR_PROVIDER=none
DLD_OCR_MIN_CONFIDENCE=0.70

# OpenAI-compatible VLM endpoint. Put real keys only in local .env.
DLD_VLM_PROVIDER=openai_compatible
DLD_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DLD_VLM_CHAT_URL=
DLD_VLM_MODEL=qwen-vl-max-latest
DLD_VLM_API_KEY=
DLD_VLM_TIMEOUT_SECONDS=60
