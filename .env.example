# DataLeakDetector runtime configuration

# Neo4j is optional. The pipeline runs without it unless this flag is enabled.
DLD_NEO4J_ENABLED=0
DLD_NEO4J_URI=bolt://localhost:7687
DLD_NEO4J_USER=neo4j
DLD_NEO4J_PASSWORD=data-leak-detector
DLD_NEO4J_DATABASE=neo4j

# If set to 1, pipeline execution fails when Neo4j write fails.
# If set to 0, graph write errors are recorded in report["graph"].
DLD_NEO4J_STRICT=0

# If set to 1, each write removes previous nodes for the same report id first.
DLD_NEO4J_CLEAR_SESSION=0
