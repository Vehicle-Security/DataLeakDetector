;
; FsFilter.inf
; Windows File System Minifilter Driver
;

[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
DriverVer   = 01/21/2026,1.0.0.0
CatalogFile = FsFilter.cat

[DestinationDirs]
DefaultDestDir          = 12
FsFilter.DriverFiles    = 12

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = FsFilter.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,FsFilter.Service

[DefaultUninstall.NTamd64]
DelFiles   = FsFilter.DriverFiles

[DefaultUninstall.NTamd64.Services]
DelService = %ServiceName%,0x200

[FsFilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\FsFilter.sys
Dependencies     = "FltMgr"
ServiceType      = 2
StartType        = 3
ErrorControl     = 1
LoadOrderGroup   = "FSFilter Activity Monitor"
AddReg           = FsFilter.AddRegistry

[FsFilter.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance.Name%,"Altitude",0x00000000,%Instance.Altitude%
HKR,"Instances\"%Instance.Name%,"Flags",0x00010001,0x0

[FsFilter.DriverFiles]
FsFilter.sys

[Strings]
ManufacturerName   = "File Monitor Solutions"
ServiceName        = "FsFilter"
ServiceDescription = "File System Monitor Driver"
DefaultInstance    = "FsFilter Instance"
Instance.Name      = "FsFilter Instance"
Instance.Altitude  = "385100"
