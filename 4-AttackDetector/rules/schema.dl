// schema.dl - Datalog 类型声明和基础事实定义
// 用于 Soufflé 引擎

// ============================================
// 类型声明
// ============================================

.type Process <: symbol
.type FilePath <: symbol
.type URL <: symbol
.type Timestamp <: number
.type Extension <: symbol
.type AppName <: symbol

// ============================================
// 输入事实声明 (从 .facts 文件加载)
// ============================================

// 文件操作事实
.decl open_file(process: Process, path: FilePath, time: Timestamp)
.input open_file

.decl create_file(process: Process, path: FilePath, time: Timestamp)
.input create_file

.decl modify_file(process: Process, path: FilePath, time: Timestamp)
.input modify_file

.decl rename_file(process: Process, src: FilePath, dst: FilePath, time: Timestamp)
.input rename_file

.decl delete_file(process: Process, path: FilePath, time: Timestamp)
.input delete_file

// 应用切换事实
.decl app_switch(from_app: AppName, to_app: AppName, time: Timestamp)
.input app_switch

// 浏览器访问事实
.decl browser_access(browser: Process, url: URL, time: Timestamp)
.input browser_access

// ============================================
// 剪贴板事实声明
// ============================================

// 剪贴板文本复制
.decl clipboard_text(process: Process, content_hash: symbol, time: Timestamp)
.input clipboard_text

// 剪贴板图片（包括截图）
.decl clipboard_image(process: Process, image_hash: symbol, time: Timestamp)
.input clipboard_image

// 剪贴板粘贴
.decl clipboard_paste(process: Process, content_hash: symbol, time: Timestamp)
.input clipboard_paste

// ============================================
// 静态配置事实
// ============================================

// 敏感文件扩展名
.decl sensitive_extension(ext: Extension)
.input sensitive_extension

// 上传/AI网站关键词
.decl upload_site(keyword: symbol)
.input upload_site

// 敏感应用
.decl sensitive_app(app: AppName)
.input sensitive_app

// 风险应用
.decl risky_app(app: AppName)
.input risky_app

// ============================================
// 辅助谓词
// ============================================

// 判断文件是否有敏感扩展名
.decl is_sensitive_file(path: FilePath)
is_sensitive_file(Path) :-
    open_file(_, Path, _),
    sensitive_extension(Ext),
    contains(Path, Ext).

is_sensitive_file(Path) :-
    create_file(_, Path, _),
    sensitive_extension(Ext),
    contains(Path, Ext).

is_sensitive_file(Path) :-
    rename_file(_, Path, _, _),
    sensitive_extension(Ext),
    contains(Path, Ext).

// 判断 URL 是否是上传站点
.decl is_upload_site(url: URL)
is_upload_site(U) :-
    browser_access(_, U, _),
    upload_site(Keyword),
    contains(U, Keyword).

// 时间窗口判断
.decl within_time_window(t1: Timestamp, t2: Timestamp, window: number)
within_time_window(T1, T2, W) :-
    T2 > T1,
    T2 - T1 < W.
