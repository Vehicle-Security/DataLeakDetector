// advanced.dl - 高级检测规则
// 重命名规避检测

#include "schema.dl"

// ============================================
// 规则: 文件重命名规避检测
// ============================================

// 敏感文件被重命名为非敏感扩展名后上传
.decl rename_evasion(
    original_file: FilePath,
    new_file: FilePath,
    url: URL,
    rename_time: Timestamp,
    access_time: Timestamp
)
.output rename_evasion

rename_evasion(Orig, New, URL, T1, T2) :-
    rename_file(_, Orig, New, T1),
    is_sensitive_file(Orig),
    !is_sensitive_file(New),
    browser_access(_, URL, T2),
    is_upload_site(URL),
    T2 > T1,
    T2 - T1 < 600.  // 10分钟内

// ============================================
// 规则: 删除后访问模式（销毁证据）
// ============================================

// 访问上传站点后删除文件
.decl delete_after_upload(
    file: FilePath,
    url: URL,
    access_time: Timestamp,
    delete_time: Timestamp
)
.output delete_after_upload

delete_after_upload(File, URL, T1, T2) :-
    browser_access(_, URL, T1),
    is_upload_site(URL),
    delete_file(_, File, T2),
    T2 > T1,
    T2 - T1 < 300.  // 5分钟内删除
