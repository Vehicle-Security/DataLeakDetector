// ===================================================================
// Souffle Datalog 规则文件 - 增强版
// 功能：基于污点追踪的数据泄露检测，支持跨进程传播和剪贴板操作
// ===================================================================

// --- 类型定义 ---
.type OperationID <: symbol
.type Proc <: symbol
.type Data <: symbol
.type Timestamp <: number

// --- 输入关系 (由 LLM 从日志生成) ---

// 1. 进程打开/读取敏感文件
.decl OpenFile(id: OperationID, p: Proc, f: Data, timestamp: Timestamp)
.input OpenFile

// 2. 文件/数据转移 (同进程内)
.decl TransferFile(id: OperationID, p: Proc, src: Data, dst: Data, timestamp: Timestamp)
.input TransferFile

// 3. 跨进程数据传输 (通过剪贴板、共享文件等)
.decl CrossProcessTransfer(id: OperationID, p1: Proc, p2: Proc, shared_data: Data, timestamp: Timestamp)
.input CrossProcessTransfer

// 4. 数据外泄操作 (网络发送、移动存储、打印等)
.decl LeakFile(id: OperationID, p: Proc, f: Data, leak_channel: symbol, timestamp: Timestamp)
.input LeakFile

// --- 剪贴板操作的抽象 (特殊形式的 TransferFile) ---

.decl ClipboardWrite(id: OperationID, p: Proc, data: Data, timestamp: Timestamp)
.input ClipboardWrite

.decl ClipboardRead(id: OperationID, p: Proc, data: Data, timestamp: Timestamp)
.input ClipboardRead

// 将剪贴板操作转换为 CrossProcessTransfer
CrossProcessTransfer(cat(write_id, "_", read_id), p_write, p_read, data, read_ts) :-
    ClipboardWrite(write_id, p_write, data, write_ts),
    ClipboardRead(read_id, p_read, data, read_ts),
    read_ts > write_ts,
    read_ts - write_ts < 300000,  // 5分钟内（毫秒）
    p_write != p_read.

// --- 中间推导关系：污点追踪 ---

.decl Tainted(p: Proc, d: Data, path: symbol, last_timestamp: Timestamp)

// --- 推理规则 ---

// 规则1: 污染源头
Tainted(p, f, id, timestamp) :- 
    OpenFile(id, p, f, timestamp).

// 规则2: 污染传播 (同进程内)
Tainted(p, dst, cat(history, " -> ", id), new_timestamp) :- 
    Tainted(p, src, history, _),
    TransferFile(id, p, src, dst, new_timestamp).

// 规则3: 跨进程污染传播
Tainted(p2, shared_data, cat(history, " -> ", id), new_timestamp) :- 
    Tainted(p1, shared_data, history, _),
    CrossProcessTransfer(id, p1, p2, shared_data, new_timestamp).

// 规则4: 污染数据的副本传播
Tainted(p, dst, cat(history, " -> ", id), new_timestamp) :- 
    Tainted(p, src, history, _),
    TransferFile(id, p, src, dst, new_timestamp),
    contains("copy", id).

// --- 最终输出关系：泄露检测 ---

.decl SearchLeak(
    start_op: symbol,  // Changed from OperationID to symbol (represents full path start)
    end_op: OperationID, 
    leaking_proc: Proc, 
    leaked_file: Data, 
    full_path: symbol,
    leak_channel: symbol,
    leak_timestamp: Timestamp
)

// 规则5: 泄露检测
// 简化版：直接使用 history 作为起始点
SearchLeak(history, leak_id, p, f, cat(history, " -> ", leak_id), channel, leak_ts) :- 
    Tainted(p, f, history, _),
    LeakFile(leak_id, p, f, channel, leak_ts).

// --- 输出配置 ---
.output SearchLeak(IO=file, filename="leak_results.csv", delimiter=",")

.decl AllTaintedPaths(p: Proc, d: Data, path: symbol, ts: Timestamp)
AllTaintedPaths(p, d, path, ts) :- Tainted(p, d, path, ts).
.output AllTaintedPaths(IO=file, filename="tainted_paths.csv", delimiter=",")
