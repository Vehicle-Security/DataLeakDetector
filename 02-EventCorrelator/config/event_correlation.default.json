    "share",
    "screen",
    "meeting",
    "forward",
    "attachment",
    "email",
    "mail",
    "chat",
    "web_post",
    "cloud_sync",
    "上传",
    "发送",
    "分享",
    "转发",
    "附件",
    "外发",
    "共享",
    "屏幕",
    "会议",
    "共享屏幕",
    "屏幕共享",
    "邮箱",
    "邮件",
    "聊天",
    "云盘"
  ],
  "upload_event_types": [
    "file_upload",
    "upload_detected",
    "file_selected"
  ]
}
